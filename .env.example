# Flask Configuration
FLASK_APP=wsgi.py
# O modo debug fica desligado no docker-compose (FLASK_DEBUG=0): ele expõe o depurador do Werkzeug
# Senha do admin criado na primeira subida (vazio = dev@123). Não altera um admin já existente.
ADMIN_PASSWORD=

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=developer
DB_PASSWORD=******
DB_NAME=tcc_20226_sesi_t3d

# MySQL Root Password
MYSQL_ROOT_PASSWORD=******

# PHPMyAdmin Configuração
# O login é pedido na tela (sem PMA_USER/PMA_PASSWORD). Por padrão só responde em 127.0.0.1;
# use outro endereço (ex.: 0.0.0.0) apenas se precisar acessá-lo de outra máquina.
PMA_HOST=mysql
PMA_BIND_ADDRESS=127.0.0.1
